# Binaries for programs and plugins
*.exe
*.dll
*.so
*.dylib

# Test binaries
*_test

# Output of 'go build'
*.out

# Dependency directories
vendor/

# Build output: bin/ holds the .exe and the NSIS installer. NOT frontend/dist,
# which is embedded into the binary and must be committed.
/bin/

# Generated by `wails3 generate syso` during a build and deleted again after.
*.syso

# go-task's checksum cache.
/.task/

# Go module cache
.cache/go-build/

# IDE specific files
.idea/
.junie/
.vscode/
*.swp
*.bak
*.swo

# Log files
logs/
*.log

# Environment variables
.env
.env.*


# OS generated files
.DS_Store
Thumbs.db
EVAL.md
OPTIMIZE.md
IDIOMATIC_GO.md

# `wails3 update build-assets` writes assets for every platform it knows about.
# This is a Windows-only application, so the rest are not kept.
/build/darwin/
/build/ios/
/build/linux/
